{
  "name": "@parama-guru/openable",
  "version": "0.2.0",
  "description": "Open files that no longer open. Runs real desktop applications inside a disposable Solari VM and returns a readable PDF, text and proof it rendered.",
  "keywords": [
    "file-recovery",
    "document-conversion",
    "corrupt-pdf",
    "legacy-formats",
    "libreoffice",
    "ghostscript",
    "sandbox",
    "solari",
    "mcp",
    "model-context-protocol"
  ],
  "homepage": "https://github.com/Parama-Guru/Solari#readme",
  "bugs": "https://github.com/Parama-Guru/Solari/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Parama-Guru/Solari.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/server.d.ts",
      "import": "./dist/mcp/server.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "openable-mcp": "dist/mcp/server.js",
    "openable-playground": "dist/server/main.js",
    "openable-provision": "dist/scripts/provision.js",
    "openable-sweep": "dist/scripts/sweep.js"
  },
  "files": [
    "dist",
    "samples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node src/scripts/copy-assets.ts",
    "prepare": "tsc -p tsconfig.build.json && node src/scripts/copy-assets.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "doctor": "node src/scripts/doctor.ts",
    "provision": "node src/scripts/provision.ts",
    "fixtures": "node src/scripts/make-fixtures.ts",
    "e2e": "node src/scripts/e2e.ts",
    "sweep": "node src/scripts/sweep.ts",
    "mcp": "node src/mcp/server.ts",
    "dev": "node src/server/main.ts",
    "start": "node src/server/main.ts"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
