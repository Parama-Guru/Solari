# Copy to .env and fill in. Never commit the real key.
SOLARI_API_KEY=
SOLARI_BASE_URL=https://api.getsolari.com

# Free tier allows 1 concurrent VM. Raise only when the plan allows it.
SOLARI_MAX_CONCURRENCY=1

# Toolchain template built by `npm run provision`. Required: the rescue does not install
# anything at request time. `base` boots in ~0.5s but has no converters, so every rescue
# fails on it. A provisioned template boots in ~11.5s and carries the whole toolchain.
SOLARI_TEMPLATE=base

PORT=3000

# Everything below is optional and already has a sensible default. It only matters if you
# expose the playground to anyone other than yourself.

# Rescues allowed per caller per minute.
# OPENABLE_RATE_LIMIT_PER_MINUTE=5

# Refuse new rescues once a rolling day has bought this much machine time. 0 disables it.
# OPENABLE_MAX_VM_SECONDS_PER_DAY=0

# Finished results held in memory before the oldest are dropped. Keep well under the RAM
# the machine actually has, since results include the PDF and one image per page.
# OPENABLE_MAX_RESULT_MB=256

# Honour X-Forwarded-For when deciding who a caller is. Only turn this on behind a proxy
# you control, or anyone can spoof their way around the rate limit.
# OPENABLE_TRUST_PROXY=false
